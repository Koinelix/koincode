{
  "name": "@koincode/wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/contract.ts",
    "./node": "./src/node.ts",
    "./host": "./src/host.ts",
    "./general": "./src/general.ts",
    "./general-receive": "./src/general-receive.ts",
    "./protected-host": "./src/protected-host.ts",
    "./local-management": "./src/local-management.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "test": "tsx --test --test-concurrency=2 --test-timeout=15000 test/*.test.ts test/general-native-trust.test.mjs",
    "build:protected-sqlite": "node scripts/build-general-protected-sqlite.mjs",
    "build:protected-bridge": "node scripts/build-general-protected-bridge.mjs",
    "build:native-trust": "node scripts/build-general-trust.mjs",
    "test:native-trust": "node --import tsx --test --test-timeout=90000 test/general-native-trust.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/ciphers": "1.3.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "ethers": "6.17.0",
    "jose": "6.2.2",
    "qrcode": "1.5.4",
    "viem": "2.57.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/qrcode": "1.5.6",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
